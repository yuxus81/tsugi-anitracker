# Werte NUR für Testläufe (Playwright). Bewusst offensichtlich unecht: die
# E2E-Tests fangen jeden Supabase-Aufruf ab, es geht nie ein Byte ins Netz.
# Dadurch hängt kein Test an privaten Zugangsdaten, und der Speicherschlüssel
# der Sitzung ist vorhersagbar (`sb-test-auth-token`).
VITE_SUPABASE_URL=https://test.supabase.co
VITE_SUPABASE_ANON_KEY=test-anon-key
# TMDB bewusst leer: das Deutsch-Overlay bleibt im Test aus, ein Netzpfad
# weniger.
VITE_TMDB_KEY=
